{
  "name": "opencode-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "OpenCode Skill Plugin Development Workspace",
  "scripts": {
    "test": "pnpm run test:root && pnpm run test:renderer",
    "test:root": "vitest",
    "test:renderer": "pnpm --filter @opencode/renderer test -- --run",
    "test:contract:schema": "vitest run test-gates/contract/schema.test.ts",
    "test:contract:load": "vitest run test-gates/contract/load.test.ts",
    "test:contract:draft": "vitest run test-gates/contract/draft.test.ts",
    "test:contract:publish": "vitest run test-gates/contract/publish.test.ts",
    "test:contract:run": "vitest run test-gates/contract/run.test.ts",
    "test:contract": "pnpm run test:contract:schema && pnpm run test:contract:load && pnpm run test:contract:draft && pnpm run test:contract:publish && pnpm run test:contract:run",
    "test:installer": "vitest run test-gates/installer/index.test.ts",
    "test:installer:npm": "vitest run test-gates/installer/npm.test.ts",
    "test:session-stream": "vitest run test-gates/session-stream/index.test.ts",
    "test:ui-errors": "vitest run test-gates/ui-errors/index.test.ts",
    "build": "pnpm -r --filter './packages/**' build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm --filter '@opencode/renderer' dev",
    "dev:electron": "pnpm --filter '@opencode/app' build && NODE_ENV=development pnpm --filter '@opencode/app' start",
    "build:app": "pnpm --filter '@opencode/renderer' build && pnpm --filter '@opencode/app' build"
  },
  "keywords": [
    "opencode",
    "skill",
    "workflow",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.38.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.22.1 <23",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "global-agent": "^4.1.3"
    }
  }
}
